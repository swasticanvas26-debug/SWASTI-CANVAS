# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (Local environment variables should NEVER be committed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Allow env templates to be committed
!.env.example
!.env.template

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS System Files
Thumbs.db

# Database / Secrets
*.sqlite
*.sqlite3
*.db
*.pem
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# portfolio assets
documentation.md
dependencies.md
